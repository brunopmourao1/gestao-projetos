# Copiar para .env.local e preencher com valores reais.
# Ver Docs/02-Tecnico/Guia-Setup-Ambiente.md

# String de conexão do banco Neon (Postgres), injetada pela integração Vercel.
DATABASE_URL=

# URL base da aplicação (usada em links de exportação de relatório).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Senha única compartilhada que protege o sistema inteiro (login simples,
# sem contas individuais). Ver middleware.ts e HU-21.
APP_PASSWORD=
